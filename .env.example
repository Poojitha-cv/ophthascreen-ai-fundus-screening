# Copy to .env. All variables use the OPH_ prefix; nested values use "__".
OPH_ENV=development                 # development | production | test
OPH_SECRET_KEY=                     # REQUIRED in production, >= 32 chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
OPH_DATABASE_URL=sqlite:///./data/app.db
# OPH_DATABASE_URL=postgresql+psycopg://user:pass@host/dbname   (pip install "psycopg[binary]")
OPH_STORAGE_DIR=data/images
OPH_MODEL_DIR=models/convnext_tiny_v1
OPH_REQUIRE_MODEL=false             # true = refuse to start if the model fails to load / hash mismatch
OPH_MODEL_DEVICE=                   # blank = cuda if available else cpu
OPH_ACCESS_TOKEN_MINUTES=60
OPH_CORS_ORIGINS=[]                 # JSON list, e.g. ["http://localhost:3000"]
OPH_PATIENT_CAN_SEE_AI_RESULTS=false
# Quality-check thresholds are UNVALIDATED heuristics - tune with scripts/quality_stats.py
# OPH_QUALITY__BLUR_LAPVAR_WARN=5.0
